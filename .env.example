# ==============================================================================
# Pi'op — Environment Configuration
# ==============================================================================

# Application Branding
PROJECT_NAME="Pi'op"

# Security & JWT Tokens
# Пусто — генерируется при первом запуске и сохраняется в data/secrets.json
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# CORS: пусто — выключен (фронтенд работает same-origin); иначе JSON-список, например ["https://example.com"]
CORS_ORIGINS=[]

# Superadmin Initial Credentials
SUPERADMIN_USERNAME=admin
# Пусто — пароль генерируется при первом запуске и выводится один раз в `docker compose logs backend`
SUPERADMIN_PASSWORD=

# Workspace Storage Limits
DEFAULT_WORKSPACE_STORAGE_QUOTA_MB=500

# Device Fingerprint Hardware Binding
# Пусто — генерируется при первом запуске и сохраняется в data/secrets.json
FINGERPRINT_PEPPER=

# Ports Mapping
FRONTEND_PORT=3000
BACKEND_PORT=8080

# Database & File System (defaults for Docker container)
DATABASE_URL=sqlite+aiosqlite:////app/data/app.db
UPLOAD_DIR=/app/data/uploads
